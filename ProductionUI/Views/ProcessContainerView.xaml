<UserControl x:Class="ProductionUI.Views.ProcessContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductionUI.Views"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400"
             Background="LightGray">

    <UserControl.DataContext>
        <vm:ProcessContainerViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Courier New Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <ControlTemplate x:Key="Template1">
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>

                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>

                    </BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel Background="Gray"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Right">

        <UniformGrid VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Columns="2"
                     Margin="5">
            <UniformGrid.Resources>
                <Style TargetType="Label">
                    <Setter Property="BorderBrush" Value="AliceBlue"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </UniformGrid.Resources>
            <Label Content="Zone: "/>
            <Label Content="{Binding ProcessLocation}"/>
            <Label Content="Program: "/>
            <Label Content="{Binding ProgramName}"/>
            <Label Content="Cycle Count: "/>
            <Label Content="{Binding CycleCount}"/>
            <Label Content="Cycle Time: "/>
            <Label Content="{Binding CycleTime}"/>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Playback: "
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"/>

            <DockPanel LastChildFill="False"
                   HorizontalAlignment="Left"
                   Margin="5"
                   Grid.Column="1">

                <Button x:Name="PlayButton"
                    Command="{Binding PlayButton}"
                    MinWidth="40"
                    Background="Transparent"
                    BorderThickness="1">
                <Button.Template>
                    <ControlTemplate>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding PlayBackRunning}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            
                            
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard x:Name="PlayButtonMouseEnterAnimation">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty=""
                                                         Duration="00:00:00.25"
                                                         To="1.1">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         Duration="00:00:00.25"
                                                         To="1.1">

                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            
                            <EventTrigger RoutedEvent="MouseLeave">

                                <BeginStoryboard x:Name="PlayButtonMouseExitAnimation">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                         Duration="00:00:00.25"
                                                         To="1">
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                         Duration="00:00:00.25"
                                                         To="1">
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>


                        </ControlTemplate.Triggers>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Path Fill="#FF239118">
                                <Path.Stroke>
                                    <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                                        <GradientStop Color="#FF215D0A" Offset="1"/>
                                        <GradientStop Color="#FF239118"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                                <Path.Data>
                                    <PathGeometry>
                                        <PathGeometry.Figures>
                                            <PathFigureCollection>
                                                <PathFigure IsClosed="True" StartPoint="0,0" IsFilled="True">
                                                    <PathFigure.Segments>
                                                        <PathSegmentCollection>
                                                            <LineSegment Point="0,24" />
                                                            <LineSegment Point="19,12" />
                                                        </PathSegmentCollection>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                            </PathFigureCollection>
                                        </PathGeometry.Figures>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>

                <Border x:Name="PauseButtonBorder" 
                        BorderBrush="DimGray" 
                        BorderThickness="2" 
                        Padding="0,6">
                    <Button x:Name="PauseButton"
                    Command="{Binding PauseButton}"
                    MinWidth="40"
                    Background="Transparent"
                    BorderThickness="1">
                    <Button.RenderTransform>
                            <ScaleTransform CenterX="0.5"
                                    CenterY="0.5"/>
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate>
                            <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding PlayBackRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <BeginStoryboard x:Name="PauseButtonMouseExitAnimation">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             Duration="00:00:00.25"
                                                             To="1">
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             Duration="00:00:00.25"
                                                             To="1">
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                </ControlTemplate.Triggers>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Rectangle Width="8"
                                       Fill="#c00"
                                       Height="25"/>
                                <Rectangle Width="3"
                                       Fill="Transparent"
                                       Height="25"/>
                                <Rectangle Width="8"
                                       Fill="#c00"
                                       Height="25"/>
                            </StackPanel>

                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </Border>
            </DockPanel>

        </Grid>
        
    </StackPanel>
</UserControl>
