<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:ListBoxesWPF="clr-namespace:ProductionUI.CustomControls" 
             mc:Ignorable="d"
             Height="auto"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Bottom">
    
    <UserControl.Resources>
        <ResourceDictionary>

            <Style TargetType="{x:Type ListBox}" x:Key="List-3D">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Red" />
                </Style.Resources>

                <Setter Property="BorderThickness" Value="0" /> 
                <Setter Property="Background" Value="{x:Null}" />

                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <ListBoxesWPF:CarouselPanel IsItemsHost="True"
                                                        ClipToBounds="True"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Grid VerticalAlignment="Bottom">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- ItemContainerStyle with the Trigger for Selected -->
            <Style x:Key="RedGlowItemContainer" TargetType="{x:Type ListBoxItem}">

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <ListBoxesWPF:FloatingGrid Margin="-30"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalAlignment="Center"
                                                       Height="auto">
                                <Border Background="LightGray"
                                        CornerRadius="11"
                                        BorderThickness="2"
                                        BorderBrush="Gray"
                                        x:Name="IconBorder"
                                        Margin="-45"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <ContentPresenter Margin="15"
                                                      />
                                </Border>
                            </ListBoxesWPF:FloatingGrid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>


            </Style>

        </ResourceDictionary>
    </UserControl.Resources>



    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <ListBox ItemsSource="{Binding ProductionDeck}"
                 Style="{DynamicResource List-3D}"
                 MaxHeight="5000"
                 HorizontalContentAlignment="Center"
                 VerticalAlignment="Bottom"
                 VerticalContentAlignment="Bottom"
             ItemContainerStyle="{StaticResource  RedGlowItemContainer}">

        <ListBox.ItemTemplate>
            <DataTemplate>

                <DockPanel Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" 
                           LastChildFill="True">

                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">

                        <Label Content="{Binding StepDataDisplay}"/>
                        <Label Content="{Binding StepPointData}"/>
                        <Label Content="{Binding StepStatus}"/>
                        <Label Content="{Binding StepActiveTime}"/>
                        <Label Content="{Binding StepPassed}"/>
                    </StackPanel>

                    <Image Source="{Binding StepImage}"
                           Visibility="{Binding ImageVisible}"
                           DockPanel.Dock="Right"/>

                </DockPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>

    </ListBox>

</UserControl>

