<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:ListBoxesWPF="clr-namespace:ProductionUI.CustomControls" 
             mc:Ignorable="d"
             Height="auto"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Bottom">
    
    <UserControl.Resources>
        <ResourceDictionary>

            <Style TargetType="{x:Type ListBox}" x:Key="List-3D">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Red" />
                </Style.Resources>

                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{x:Null}"/>

                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <ListBoxesWPF:CarouselPanel IsItemsHost="True"
                                                        ClipToBounds="True"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Template">   
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Grid VerticalAlignment="Bottom">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- ItemContainerStyle with the Trigger for Selected -->
            <Style x:Key="CardContainer" TargetType="{x:Type ListBoxItem}">

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <ListBoxesWPF:FloatingGrid Margin="-30"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalAlignment="Center"
                                                       Height="auto">

                                <Border Background="LightGray"
                                        CornerRadius="11"
                                        BorderThickness="2"
                                        BorderBrush="#522"
                                        x:Name="CardBorder"
                                        Margin="-100"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <ContentPresenter Margin="15">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                     

                                                <DockPanel x:Name="deckDockPanel"
                                                           Margin="15"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" 
                                                           LastChildFill="True"
                                                           MinHeight="10"
                                                           MinWidth="10"
                                                           MaxHeight="500"
                                                           MaxWidth="{Binding ActualHeight, ElementName=cardList}">

                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">

                                                        <Label Content="{Binding StepDataDisplay}"/>
                                                        <Label Content="{Binding StepStatus}"/>
                                                        <Label Content="{Binding StepActiveTime}"/>
                                                    </StackPanel>

                                                    <Image Source="{Binding StepImage}"
                                                           x:Name="image1"
                                                           Visibility="Collapsed"
                                                           DockPanel.Dock="Right"/>

                                                </DockPanel>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource=
                                                                            {RelativeSource Mode=FindAncestor, AncestorType=
                                                                                {x:Type ListBoxItem}},Path=IsSelected}" Value="True">
                                                        <Setter TargetName="image1" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="deckDockPanel" Property="MinHeight" Value="200"/>
                                                        <Setter TargetName="deckDockPanel" Property="MinWidth" Value="200"/>
                                                        <Setter TargetName="deckDockPanel" Property="Margin" Value="1"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                                
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </ListBoxesWPF:FloatingGrid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>


            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <ListBox ItemsSource="{Binding ProductionDeck}"
             x:Name="cardList"
             Style="{DynamicResource List-3D}"
             MaxHeight="5000"
             HorizontalContentAlignment="Center"
             VerticalAlignment="Bottom"
             VerticalContentAlignment="Bottom"
             ItemContainerStyle="{StaticResource CardContainer}">
    </ListBox>

</UserControl>

