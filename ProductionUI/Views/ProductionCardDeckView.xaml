<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:CustomControls="clr-namespace:ProductionUI.CustomControls" 
             xmlns:userControls="clr-namespace:ProductionUI.Views"
             xmlns:local="clr-namespace:ProductionUI"
             mc:Ignorable="d"
             Height="auto"
             MaxWidth="1200"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Bottom">

    <UserControl.Resources>
        <ResourceDictionary>

            <Style x:Key="LabelStyler" TargetType="{x:Type Label}">
                <Setter Property="FontFamily" Value="Segoe UI Bold"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            
            <DataTemplate x:Key="ListItemDataTemplate">
                <DockPanel x:Name="CardDataDockPanel"
                           LastChildFill="True"
                           SnapsToDevicePixels="True">
                    <DockPanel.RenderTransform>
                        <ScaleTransform/>
                    </DockPanel.RenderTransform>

                    <StackPanel x:Name="CardDataStackPanel"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="5"
                                UseLayoutRounding="True">

                        <TextBlock Text="{Binding StepTitle}"
                                   FontFamily="Segoe UI Bold"
                                   FontSize="14"
                                   x:Name="StepTitle"
                                   UseLayoutRounding="True">
                            <TextBlock.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="0" 
                                                     CenterX="0.5" 
                                                     CenterY="0.5"/>
                                </TransformGroup>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding StepStatus}"
                                   FontFamily="Segoe UI Bold"
                                   FontSize="14"
                                   x:Name="StepStatus"
                                   UseLayoutRounding="True">
                        </TextBlock>
                        <TextBlock Text="{Binding StepActiveTime}"
                                   FontFamily="Segoe UI Bold"
                                   FontSize="14"
                                   x:Name="StepActiveTime"
                                   UseLayoutRounding="True">
                        </TextBlock>
                    </StackPanel>


                    <Image Source="{Binding StepImage}"
                          x:Name="StepImage"
                          Visibility="Collapsed"
                          Stretch="Uniform"
                          Height="0"
                          Width="0"
                          UseLayoutRounding="True"/>

                </DockPanel>

                <DataTemplate.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding StepComplete}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepTitle" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="StepStatus" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepActiveTime" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Height" Value="0"/>
                            <Setter TargetName="StepImage" Property="Width" Value="0"/>
                            <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Right"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding StepComplete}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepTitle" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="StepStatus" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepActiveTime" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Height" Value="0"/>
                            <Setter TargetName="StepImage" Property="Width" Value="0"/>
                            <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Left" />
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                    <DataTrigger Binding="{Binding IsActiveStep}" Value="True">
                        <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="StepImage" Property="Height" Value="{Binding ElementName=CardDataDockPanel, Path=ActualHeight, Converter={StaticResource TwoThirdValue}}"/>
                        <Setter TargetName="StepImage" Property="Width" Value="{Binding ElementName=CardDataDockPanel, Path=ActualWidth}, Converter={StaticResource TwoThirdValue}"/>
                    </DataTrigger>

                </DataTemplate.Triggers>

            </DataTemplate>

            <CustomControls:FirstDegreeFunctionConverter x:Key="AddOneToValue" 
                                                         A="1" 
                                                         B="1"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="DoubleValue"
                                                         A="2"
                                                         B="0"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="OneThirdValue"
                                                         A=".3333"
                                                         B="0"/>

            <CustomControls:FirstDegreeFunctionConverter x:Key="TwoThirdValue"
                                                         A=".6"
                                                         B="0"/>

            <!-- ItemContainerStyle with the Trigger for Selected -->
            <Style x:Key="ListBoxItemCardStyler"
                   TargetType="{x:Type ListBoxItem}">

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <CustomControls:FloatingGrid x:Name="FloatingGridContentHost"
                                                         Cursor="Hand">
                                <CustomControls:FloatingGrid.RenderTransform>
                                    <TranslateTransform/>
                                </CustomControls:FloatingGrid.RenderTransform>


                                <Border CornerRadius="5"
                                        BorderThickness="1"
                                        BorderBrush="#444"
                                        x:Name="CardBorder"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">

                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,2" StartPoint="3,0">
                                            <GradientStop Color="#FFAEAEAE" Offset="0.6"/>
                                            <GradientStop Color="#FE6A6A6A" Offset="1.2"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BitmapEffect>
                                        <BlurBitmapEffect Radius="1" KernelType="Gaussian"/>
                                    </Border.BitmapEffect>

                                    <ContentPresenter x:Name="CardContentPresenter"
                                                      ContentTemplate="{StaticResource ListItemDataTemplate}"/>
                                </Border>
                            </CustomControls:FloatingGrid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="TopPanelGrid"
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True"
                   VerticalAlignment="Stretch"
                   Background="#555">

            <userControls:ProcessContainerView DockPanel.Dock="Left"
                                               MinWidth="15">
                
            </userControls:ProcessContainerView>


            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Center"
                        Background="AntiqueWhite">
                <Label Content="Program Step: " 
                       Style="{StaticResource LabelStyler}"/>
                <Label Content="{Binding ElementName=CardDeckListBox, Converter={StaticResource AddOneToValue}, Path=SelectedIndex}"
                       Style="{StaticResource LabelStyler}"/>
                <Label Content=" / "
                       Style="{StaticResource LabelStyler}"/>
                <Label Content="{Binding ElementName=CardDeckListBox, Path=Items.Count}"
                       Style="{StaticResource LabelStyler}"/>
            </StackPanel>

            <Viewbox HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Stretch="Uniform"
                     DockPanel.Dock="Left"
                     >
            <Image Source="{Binding ProcessDisplay}"
                   Margin="5"
                   />
            </Viewbox>
        </DockPanel>

        <ListBox x:Name="CardDeckListBox"
                 ItemsSource="{Binding ProductionDeck}"
                 AlternationCount="{Binding ProductionDeck.Count}"
                 MaxHeight="{Binding ElementName=TopPanelGrid, Path=ActualHeight}"
                 DockPanel.Dock="Bottom"
                 VerticalAlignment="Stretch"
                 SelectedIndex="{Binding CurrentIndex}"
                 ItemContainerStyle="{DynamicResource ListBoxItemCardStyler}"
                 Background="Violet"
                 Grid.Row="1">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <CustomControls:CarouselPanel IsItemsHost="True"
                                                  x:Name="CarouselPanelItemHost">
                        <CustomControls:CarouselPanel.Triggers>
                            
                        </CustomControls:CarouselPanel.Triggers>
                    </CustomControls:CarouselPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Grid VerticalAlignment="Bottom">
                        <ItemsPresenter/>


                    </Grid>
                </ControlTemplate>
            </ListBox.Template>

            <ListBox.Resources>

            </ListBox.Resources>

        </ListBox>

    </Grid>
</UserControl>