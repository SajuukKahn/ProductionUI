<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:CustomControls="clr-namespace:ProductionUI.CustomControls" 
             mc:Ignorable="d"
             Height="auto"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Bottom">
    
    <UserControl.Resources>
        <ResourceDictionary>

            <CustomControls:FirstDegreeFunctionConverter x:Key="AddOneToValue" 
                                                      A="1" 
                                                      B="1"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="DoubleValue"
                                                      A="2"
                                                      B="0"/>

            <Style TargetType="{x:Type ListBox}" x:Key="ListBox3DStyle">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Red" />
                </Style.Resources>

                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{x:Null}"/>

                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <CustomControls:CarouselPanel IsItemsHost="True"
                                                        ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Template">   
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}" 
                                         x:Name="ListBoxControlTemplate">
                            <Grid VerticalAlignment="Bottom">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                x:Name="ListBoxControlTemplateItemsPresenter"
                                                />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- ItemContainerStyle with the Trigger for Selected -->
            <Style x:Key="ListBoxItemCardStyler" 
                   TargetType="{x:Type ListBoxItem}">

                <Setter Property="Template" x:Name="ListBoxItemCardStyleSetter">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}" x:Name="CardControlTemplate">
                            <CustomControls:FloatingGrid Margin="0"
                                                       x:Name="FloatingGridCardContainer">

                                <Border Background="LightGray"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="#322"
                                        x:Name="CardBorder"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Margin="0">
                                    <ContentPresenter x:Name="CardContentPresenter">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                     

                                                <DockPanel x:Name="CardDataDockPanel"
                                                           Margin="0"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           LastChildFill="True">

                                                    <StackPanel x:Name="CardDataStackPanel"
                                                                DockPanel.Dock="Left"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Program Step: "/>
                                                            <TextBlock Text="{Binding RelativeSource=
                                                                                {RelativeSource TemplatedParent}, Converter={StaticResource AddOneToValue}, Path=TemplatedParent.(ItemsControl.AlternationIndex)}"/>
                                                            <TextBlock Text=" / "/>
                                                            <TextBlock Text="{Binding ElementName=CardDeckListBox, Path=Items.Count}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StepDataDisplay}"/>
                                                        <TextBlock Text="{Binding StepStatus}"/>
                                                        <TextBlock Text="{Binding StepActiveTime}"/>
                                                    </StackPanel>

                                                    <Image Source="{Binding StepImage}"
                                                           x:Name="StepImage"
                                                           Visibility="Collapsed"
                                                           DockPanel.Dock="Right"/>

                                                </DockPanel>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource=
                                                                            {RelativeSource Mode=FindAncestor, AncestorType=
                                                                                {x:Type ListBoxItem}},Path=IsSelected}" Value="True">
                                                        <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Top"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                                
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </CustomControls:FloatingGrid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>


            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Image Source="{Binding ProcessDisplay}"
                   Stretch="Uniform"
                   StretchDirection="Both">
        </Image>


        <!--<MediaElement x:Name="ProcessImage"
                      Width="auto"
                      Height="auto"
                      Source="{Binding ProcessImage}"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="Uniform"
                      MinHeight="50"
                      MinWidth="50"
                      StretchDirection="Both"
                      ScrubbingEnabled="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      DockPanel.Dock="Top">
            <MediaElement.OpacityMask>
                <ImageBrush ImageSource="{Binding ProcessImage}"/>
            </MediaElement.OpacityMask>
        </MediaElement>-->
        <ListBox x:Name="CardDeckListBox"
                 ItemsSource="{Binding ProductionDeck}"
                 AlternationCount="{Binding ProductionDeck.Count}"
                 Style="{DynamicResource ListBox3DStyle}"
                 MaxHeight="300"
                 ItemContainerStyle="{StaticResource ListBoxItemCardStyler}"
                 DockPanel.Dock="Bottom"
                 Grid.Row="1">
        </ListBox>
    </Grid>
</UserControl>

