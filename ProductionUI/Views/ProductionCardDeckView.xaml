<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:CustomControls="clr-namespace:ProductionUI.CustomControls" 
             mc:Ignorable="d"
             Height="auto"
             MaxWidth="1200"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>

            <CustomControls:FirstDegreeFunctionConverter x:Key="AddOneToValue" 
                                                         A="1" 
                                                         B="1"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="DoubleValue"
                                                         A="2"
                                                         B="0"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="OneThirdValue"
                                                         A=".3333"
                                                         B="0"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="TwoThirdValue"
                                                         A=".6"
                                                         B="0"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="AutoFontSizer"
                                                         A=".08"
                                                         B="0"/>
            <CustomControls:BoolToVisibilityConverter x:Key="BoolToVisibility"/>


            <Style x:Key="LabelStyler" TargetType="{x:Type Label}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="ButtonStyler" TargetType="{x:Type Button}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            
            </Style>

            <ControlTemplate TargetType="Button" 
                             x:Key="PlayBackButtonControlTemplate">
                <Viewbox x:Name="ContentGrid" 
                         Stretch="Uniform" 
                         Height="96">

                    <Border x:Name="ButtonBorder" 
                            BorderBrush="Transparent" 
                            BorderThickness="2"
                            Background="Gray"
                            Padding="0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1"/>
                                <SkewTransform AngleX="0" AngleY="0"/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </Viewbox>
                <ControlTemplate.Triggers>

                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderThickness" FillBehavior="HoldEnd">
                                <ThicknessAnimation Duration="00:00:00:1" To="3">
                                    <ThicknessAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderThickness" FillBehavior="HoldEnd">
                                <ThicknessAnimation Duration="00:00:00:1" To="2">
                                    <ThicknessAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <!--<EventTrigger RoutedEvent="PreviewMouseDown">
                        <BeginStoryboard>
                            <Storyboard FillBehavior="HoldEnd">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                    <EasingDoubleKeyFrame KeyTime="00:00:00.0000000" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0.7"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="PreviewMouseUp">
                        <BeginStoryboard>
                            <Storyboard FillBehavior="HoldEnd">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                    <EasingDoubleKeyFrame KeyTime="00:00:00.0000000" Value="0.7"/>
                                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                    <DiscreteObjectKeyFrame KeyTime="00:00:00.3000000" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>-->

                </ControlTemplate.Triggers>
            </ControlTemplate>


            <Style x:Key="ComboBoxItemStyle"
                   TargetType="{x:Type ComboBoxItem}">
                <Style.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <StackPanel>
                                <UniformGrid Columns="3"
                                             Background="LightGray">

                                    <Label Content="{Binding ProgramName}"
                                           Style="{StaticResource LabelStyler}"
                                           HorizontalAlignment="Left"/>
                                    <Label Content="{Binding ProductRelationship}"
                                           Style="{StaticResource LabelStyler}"
                                           HorizontalAlignment="Left"/>
                                    <Label Content="{Binding ProgramCreator}"
                                           Style="{StaticResource LabelStyler}"
                                           HorizontalAlignment="Left"/>

                                </UniformGrid>
                                </StackPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style.Setters>
            </Style>

            <DataTemplate x:Key="ListItemDataTemplate">
                <Border CornerRadius="12"
                        FocusVisualStyle="{x:Null}"
                        BorderThickness="2"
                        ClipToBounds="False"
                        x:Name="CardBorder"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        UseLayoutRounding="True">
                    
                    <Border.BorderBrush>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop x:Name="BorderBrushGradientStop1"  Color="#FF444444"/>
                            <GradientStop x:Name="BorderBrushGradientStop2"  Color="#FF666666" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0.5,2" StartPoint="3,0">
                            <GradientStop Color="#999" Offset="0.7"/>
                            <GradientStop Color="#fff" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <Border.BitmapEffect>
                        <BlurBitmapEffect Radius="1" KernelType="Gaussian"/>
                    </Border.BitmapEffect>

                    <DockPanel x:Name="CardDataDockPanel"
                           LastChildFill="True"
                           SnapsToDevicePixels="True">
                        <DockPanel.RenderTransform>
                            <ScaleTransform/>
                        </DockPanel.RenderTransform>

                        <StackPanel x:Name="CardDataStackPanel"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                Margin="5"
                                UseLayoutRounding="True">

                            <TextBlock Text="{Binding StepTitle}"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       x:Name="StepTitle"
                                       ClipToBounds="True"
                                       UseLayoutRounding="True"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.LayoutTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="90" 
                                                         CenterX="0.5" 
                                                         CenterY="0.5"/>
                                    </TransformGroup>
                                </TextBlock.LayoutTransform>
                            </TextBlock>

                            <TextBlock Text="{Binding StepStatus}"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    x:Name="StepStatus"
                                    UseLayoutRounding="True">
                            </TextBlock>

                            <TextBlock Text="{Binding StepActiveTime}"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   x:Name="StepActiveTime"
                                   UseLayoutRounding="True">
                            </TextBlock>
                        </StackPanel>

                        <Image Source="{Binding StepImage}"
                          x:Name="StepImage"
                          Visibility="Collapsed"
                          Stretch="Uniform"
                          Height="0"
                          Width="0"
                          UseLayoutRounding="True"/>

                    </DockPanel>
                </Border>

                <DataTemplate.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding StepComplete}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepTitle" Property="TextBlock.FontSize" Value="10"/>
                            <Setter TargetName="StepStatus" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepActiveTime" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Height" Value="0"/>
                            <Setter TargetName="StepImage" Property="Width" Value="0"/>
                            <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Right"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding StepComplete}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepTitle" Property="TextBlock.FontSize" Value="10"/>
                            <Setter TargetName="StepStatus" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepActiveTime" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Height" Value="0"/>
                            <Setter TargetName="StepImage" Property="Width" Value="0"/>
                            <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Left" />
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                    <!--<DataTrigger Binding="{Binding IsActiveStep}" Value="True">
                        <Setter TargetName="StepTitle" Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="0"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="StepImage" Property="Height" Value="{Binding ElementName=CardDataDockPanel, Path=ActualHeight, Converter={StaticResource TwoThirdValue}}"/>
                        <Setter TargetName="StepImage" Property="Width" Value="{Binding ElementName=CardDataDockPanel, Path=ActualWidth, Converter={StaticResource TwoThirdValue}}"/>
                    </DataTrigger>-->

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="True"/>
                            <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.PlayBackRunning}" Value="True"/>
                        </MultiDataTrigger.Conditions>

                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepTitle" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="StepImage" Property="Height" Value="{Binding ElementName=CardDataDockPanel, Path=ActualHeight, Converter={StaticResource TwoThirdValue}}"/>
                            <Setter TargetName="StepImage" Property="Width" Value="{Binding ElementName=CardDataDockPanel, Path=ActualWidth, Converter={StaticResource TwoThirdValue}}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="True"/>
                            <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Path=DataContext.PlayBackRunning}" Value="False"/>
                        </MultiDataTrigger.Conditions>

                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" RepeatBehavior="Forever">
                                        <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        <EasingDoubleKeyFrame KeyTime="00:00:01" Value="359"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <ThicknessAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderThickness)" FillBehavior="HoldEnd" To="3,3,3,3" Duration="00:00:00.5">
                                        <ThicknessAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseIn"/>
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                        <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF444444"/>
                                        <EasingColorKeyFrame KeyTime="00:00:01" Value="#FFD61010"/>
                                    </ColorAnimationUsingKeyFrames>
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                        <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF666666"/>
                                        <EasingColorKeyFrame KeyTime="00:00:01" Value="#FF7C1919"/>
                                    </ColorAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>

                        <MultiDataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                        <EasingDoubleKeyFrame KeyTime="00:00:00.5" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <ThicknessAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderThickness)" FillBehavior="HoldEnd" To="2,2,2,2"  Duration="00:00:00.5">
                                        <ThicknessAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseIn"/>
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                        <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFD61010"/>
                                        <EasingColorKeyFrame KeyTime="00:00:00.5" Value="#FF444444"/>
                                    </ColorAnimationUsingKeyFrames>
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                        <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF7C1919"/>
                                        <EasingColorKeyFrame KeyTime="00:00:00.5" Value="#FF666666"/>
                                    </ColorAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.ExitActions>

                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepTitle" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="StepImage" Property="Height" Value="{Binding ElementName=CardDataDockPanel, Path=ActualHeight, Converter={StaticResource TwoThirdValue}}"/>
                            <Setter TargetName="StepImage" Property="Width" Value="{Binding ElementName=CardDataDockPanel, Path=ActualWidth, Converter={StaticResource TwoThirdValue}}"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                </DataTemplate.Triggers>

            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="TopPanelGrid"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="220"/>
            <RowDefinition Height="2*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True"
                   Background="#555">


            <StackPanel Background="Gray"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Right"
                        Width="300">

                <Border BorderBrush="#333"
                        BorderThickness="2"
                        Margin="5">
                    <UniformGrid VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Columns="2">

                        <Label Content="Selected Program:"
                                   Style="{StaticResource LabelStyler}"/>
                        <ComboBox ItemsSource="{Binding ProductionPrograms}"
                                  SelectedIndex="{Binding CurrentProgram, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  DisplayMemberPath="ProgramName"/>

                        <Label Content="Cycle Count: "
                               Style="{StaticResource LabelStyler}"/>
                        <Label Content="{Binding CycleCount}"
                               Style="{StaticResource LabelStyler}"/>
                        <Label Content="Program Step: " 
                               Style="{StaticResource LabelStyler}"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding ElementName=CardDeckListBox, Converter={StaticResource AddOneToValue}, Path=SelectedIndex}"
                                   Style="{StaticResource LabelStyler}"/>
                            <Label Content=" / "
                                   Style="{StaticResource LabelStyler}"/>
                            <Label Content="{Binding CardCount}"
                                   Style="{StaticResource LabelStyler}"/>
                        </StackPanel>
                        <Label Content="Cycle Time: "
                               Style="{StaticResource LabelStyler}"/>
                        <Label Content="{Binding CycleTime}"
                               Style="{StaticResource LabelStyler}"/>
                    </UniformGrid>
                </Border>


                <DockPanel LastChildFill="False"
                           HorizontalAlignment="Center"
                           Margin="5"
                           Grid.Column="1">

                    <Button x:Name="PlayButton"
                            Command="{Binding PlayButton}"
                            Background="Transparent"
                            Style="{StaticResource ButtonStyler}"
                            Template="{StaticResource PlayBackButtonControlTemplate}"
                            Visibility="{Binding PlayAvailable, Converter={StaticResource BoolToVisibility}}"
                            BorderThickness="1">

                        <Button.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Button.RenderTransformOrigin>

                        <Button.Content>
                            <Grid Height="32" Width="32">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path Fill="#FF239118">
                                        <Path.Stroke>
                                            <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                                                <GradientStop Color="#FF215D0A" Offset="1"/>
                                                <GradientStop Color="#FF239118"/>
                                            </LinearGradientBrush>
                                        </Path.Stroke>
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathGeometry.Figures>
                                                    <PathFigureCollection>
                                                        <PathFigure IsClosed="True" StartPoint="0,0" IsFilled="True">
                                                            <PathFigure.Segments>
                                                                <PathSegmentCollection>
                                                                    <LineSegment Point="0,24" />
                                                                    <LineSegment Point="19,12" />
                                                                </PathSegmentCollection>
                                                            </PathFigure.Segments>
                                                        </PathFigure>
                                                    </PathFigureCollection>
                                                </PathGeometry.Figures>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                </StackPanel>
                            </Grid>
                        </Button.Content>
                    </Button>

                    <Button x:Name="PauseButton"
                            Command="{Binding PauseButton}"
                            Background="Transparent"
                            Style="{StaticResource ButtonStyler}"
                            Template="{StaticResource PlayBackButtonControlTemplate}"
                            Visibility="{Binding PauseAvailable,Converter={StaticResource BoolToVisibility}}"
                            BorderThickness="1">

                        <Button.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Button.RenderTransformOrigin>


                        <Button.Content>
                            <Grid Width="32" Height="32" >
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border BorderThickness="1">
                                        <Rectangle Width="8"
                                                   Fill="#c00"
                                                   Height="25"/>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                                                <GradientStop Color="#FF881111" Offset="0.5"/>
                                                <GradientStop Color="#FFCC0000"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                    <Rectangle Width="3"
                                               Fill="Transparent"
                                               Height="25"/>
                                    <Border BorderThickness="1">
                                        <Rectangle Width="8"
                                                   Fill="#c00"
                                                   Height="25"/>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                                                <GradientStop Color="#FF881111" Offset="1"/>
                                                <GradientStop Color="#FFCC0000"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button.Content>
                    </Button>
                </DockPanel>

            </StackPanel>

            <Viewbox HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stretch="Uniform"
                     DockPanel.Dock="Top"
                     StretchDirection="DownOnly">
                <Image Source="{Binding ProcessDisplay}"
                       Margin="5"/>
            </Viewbox>

        </DockPanel>

        <ListBox x:Name="CardDeckListBox"
                 ItemsSource="{Binding ProductionDeck}"
                 AlternationCount="{Binding ProductionDeck.Count}"
                 MaxHeight="{Binding ElementName=TopPanelGrid, Path=ActualHeight}"
                 DockPanel.Dock="Bottom"
                 PreviewKeyDown="CardDeckListBox_PreviewKeyDown"
                 VerticalAlignment="Stretch"
                 SelectedIndex="{Binding CurrentIndex}"
                 SelectionMode="Single"
                 Background="Violet"
                 Grid.Row="1"
                 IsHitTestVisible="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <CustomControls:CarouselPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter ContentTemplate="{StaticResource ListItemDataTemplate}"
                                                  FocusVisualStyle="{x:Null}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Grid VerticalAlignment="Bottom">
                        <ItemsPresenter/>
                    </Grid>
                </ControlTemplate>
            </ListBox.Template>

            <ListBox.Resources>

            </ListBox.Resources>

        </ListBox>
    </Grid>
</UserControl>