<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:CustomControls="clr-namespace:ProductionUI.CustomControls" 
             xmlns:userControls="clr-namespace:ProductionUI.Views"
             mc:Ignorable="d"
             Height="auto"
             MaxWidth="800"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Bottom">
    
    <UserControl.Resources>
        <ResourceDictionary>

            <CustomControls:FirstDegreeFunctionConverter x:Key="AddOneToValue" 
                                                         A="1" 
                                                         B="1"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="DoubleValue"
                                                         A="2"
                                                         B="0"/>

            <Style TargetType="{x:Type ListBox}" x:Key="ListBox3DStyle">

                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{x:Null}"/>

                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <CustomControls:CarouselPanel IsItemsHost="True"
                                                          ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Template">   
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}" 
                                         x:Name="ListBoxControlTemplate">
                            <Grid VerticalAlignment="Bottom">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                x:Name="ListBoxControlTemplateItemsPresenter"
                                                MaxHeight="1000"/>

                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- ItemContainerStyle with the Trigger for Selected -->
            <Style x:Key="ListBoxItemCardStyler"
                   TargetType="{x:Type ListBoxItem}">

                <Setter Property="Template" x:Name="ListBoxItemCardStyleSetter">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}" 
                                         x:Name="CardControlTemplate">
                            <CustomControls:FloatingGrid Margin="0"
                                                         x:Name="FloatingGridCardContainer"
                                                         SnapsToDevicePixels="True">

                                <Border Background="LightGray"
                                        CornerRadius="5"
                                        BorderThickness="1"
                                        BorderBrush="#322"
                                        x:Name="CardBorder"
                                        ClipToBounds="False"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <ContentPresenter x:Name="CardContentPresenter">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>

                                                <DockPanel x:Name="CardDataDockPanel"
                                                                Margin="0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                LastChildFill="True"
                                                                SnapsToDevicePixels="True">

                                                        <StackPanel x:Name="CardDataStackPanel"
                                                                    DockPanel.Dock="Left"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="5">

                                                            <TextBlock Text="{Binding StepDataDisplay}"/>
                                                            <TextBlock Text="{Binding StepStatus}"/>
                                                            <TextBlock Text="{Binding StepActiveTime}"/>
                                                        </StackPanel>



                                                    <Image Source="{Binding StepImage}"
                                                               x:Name="StepImage"
                                                               Visibility="Collapsed"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center"
                                                               Height="0"
                                                               Width="0"
                                                               HorizontalAlignment="Left"
                                                               DockPanel.Dock="Right"/>
                                                </DockPanel>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource=
                                                                            {RelativeSource Mode=FindAncestor, AncestorType=
                                                                                {x:Type ListBoxItem}},Path=IsSelected}" Value="True">
                                                        <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Left"/>
                                                        <Setter TargetName="StepImage" Property="Height" Value="128"/>
                                                        <Setter TargetName="StepImage" Property="Width" Value="128"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding RelativeSource=
                                                                            {RelativeSource Mode=FindAncestor,AncestorType=
                                                                                {x:Type ListBox}},Path = SelectedIndex}"
                                                                 Value=">">

                                                    </DataTrigger>

                                                </DataTemplate.Triggers>

                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                            </CustomControls:FloatingGrid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="TopPanelGrid"
            HorizontalAlignment="Center"
          VerticalAlignment="Top">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True"
                   VerticalAlignment="Top">


            <userControls:ProcessContainerView DockPanel.Dock="Left"
                                               MinWidth="50"
                                               Panel.ZIndex="99999999"/>


            <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Center">
                <Label Content="Program Step: "/>
                <Label Content="{Binding ElementName=CardDeckListBox, Converter={StaticResource AddOneToValue}, Path=SelectedIndex}"/>
                <Label Content=" / "/>
                <Label Content="{Binding ElementName=CardDeckListBox, Path=Items.Count}"/>
            </StackPanel>

            <Image Source="{Binding ProcessDisplay}"
                        Stretch="Uniform"
                        StretchDirection="Both"
                        DockPanel.Dock="Left"
                        HorizontalAlignment="Center">
            </Image>
        </DockPanel>

        <!--<MediaElement x:Name="ProcessImage"
                      Width="auto"
                      Height="auto"
                      Source="{Binding ProcessImage}"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="Uniform"
                      MinHeight="50"
                      MinWidth="50"
                      StretchDirection="Both"
                      ScrubbingEnabled="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      DockPanel.Dock="Top">
            <MediaElement.OpacityMask>
                <ImageBrush ImageSource="{Binding ProcessImage}"/>
            </MediaElement.OpacityMask>
        </MediaElement>-->
        <ListBox x:Name="CardDeckListBox"
                 ItemsSource="{Binding ProductionDeck}"
                 AlternationCount="{Binding ProductionDeck.Count}"
                 Style="{DynamicResource ListBox3DStyle}"
                 MaxHeight="300"
                 ItemContainerStyle="{StaticResource ListBoxItemCardStyler}"
                 DockPanel.Dock="Bottom"
                 SnapsToDevicePixels="True"
                 Grid.Row="1">
            
        </ListBox>
    </Grid>
</UserControl>

