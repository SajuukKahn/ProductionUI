<UserControl x:Class="ProductionUI.Views.ProductionCardDeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             xmlns:CustomControls="clr-namespace:ProductionUI.CustomControls" 
             xmlns:userControls="clr-namespace:ProductionUI.Views"
             mc:Ignorable="d"
             Height="auto"
             MaxWidth="800"
             VerticalContentAlignment="Stretch"
             VerticalAlignment="Bottom">

    <UserControl.Resources>
        <ResourceDictionary>

            <DataTemplate x:Key="ListItemDataTemplate">
                <DockPanel x:Name="CardDataDockPanel"
                           Margin="0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           LastChildFill="False"
                           SnapsToDevicePixels="True">
                    <DockPanel.RenderTransform>
                        <ScaleTransform/>
                    </DockPanel.RenderTransform>
                    


                    <StackPanel x:Name="CardDataStackPanel"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="5">

                        <TextBlock Text="{Binding StepDataDisplay}"
                                   x:Name="StepDataDisplay">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="0" 
                                                     CenterX="0.5" 
                                                     CenterY="0.5"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding StepStatus}"
                                   x:Name="StepStatus">
                        </TextBlock>
                        <TextBlock Text="{Binding StepActiveTime}"
                                   x:Name="StepActiveTime">
                        </TextBlock>
                    </StackPanel>


                    <Image Source="{Binding StepImage}"
                          x:Name="StepImage"
                          Visibility="Collapsed"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Height="0"
                          Width="0"
                          HorizontalAlignment="Center"/>

                </DockPanel>

                <DataTemplate.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding StepComplete}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepDataDisplay" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="StepStatus" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepActiveTime" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Height" Value="0"/>
                            <Setter TargetName="StepImage" Property="Width" Value="0"/>
                            <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Right"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding StepComplete}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="StepDataDisplay" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="StepStatus" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepActiveTime" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StepImage" Property="Height" Value="0"/>
                            <Setter TargetName="StepImage" Property="Width" Value="0"/>
                            <Setter TargetName="CardDataStackPanel" Property="DockPanel.Dock" Value="Left" />
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                    <DataTrigger Binding="{Binding ElementName=CardDeckListBox, Path=IsSelected}" Value="True">
                        <Setter TargetName="StepImage" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="StepImage" Property="Height" Value="128"/>
                        <Setter TargetName="StepImage" Property="Width" Value="128"/>
                    </DataTrigger>



                    <!--<MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsActiveStep}" Value="False"/>
                            <Condition Binding="{Binding ElementName=CardDataDockPanel, Path=IsMouseOver}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard x:Name="ListBoxItemHoverStoryBoard">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardDataDockPanel"
                                                     Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     Duration="00:00:00.01"
                                                     To="1.1"/>
                                    <DoubleAnimation Storyboard.TargetName="CardDataDockPanel"
                                                     Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     Duration="00:00:00.01"
                                                     To="1.1"/>

                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="ListBoxItemHoverStoryBoard"/>

                        </MultiDataTrigger.ExitActions>
                        
                    </MultiDataTrigger>-->

                </DataTemplate.Triggers>

            </DataTemplate>

            <CustomControls:FirstDegreeFunctionConverter x:Key="AddOneToValue" 
                                                         A="1" 
                                                         B="1"/>
            <CustomControls:FirstDegreeFunctionConverter x:Key="DoubleValue"
                                                         A="2"
                                                         B="0"/>

            <!-- ItemContainerStyle with the Trigger for Selected -->
            <Style x:Key="ListBoxItemCardStyler"
                   TargetType="{x:Type ListBoxItem}">

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <CustomControls:FloatingGrid x:Name="FloatingGridContentHost"
                                                         Cursor="Hand"
                                                         >
                                <CustomControls:FloatingGrid.RenderTransform>
                                    <TranslateTransform/>
                                </CustomControls:FloatingGrid.RenderTransform>
                                <CustomControls:FloatingGrid.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">

                                        <BeginStoryboard x:Name="ListBoxMouseEnterAnimation">
                                            <Storyboard Storyboard.TargetName="FloatingGridContentHost">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                                    Duration="00:00:00.25"
                                                                    To="-25">
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                    Duration="00:00:00.25"
                                                                    To="25">

                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">

                                        <BeginStoryboard x:Name="ListBoxMouseExitAnimation">
                                            <Storyboard Storyboard.TargetName="FloatingGridContentHost">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                                        Duration="00:00:00.25"
                                                                        To="0">
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                        Duration="00:00:00.25"
                                                                        To="0">
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    
                                </CustomControls:FloatingGrid.Triggers>
                                
                                
                                <Border CornerRadius="5"
                                        BorderThickness="1"
                                        BorderBrush="#444"
                                        x:Name="CardBorder"
                                        ClipToBounds="False"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">

                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,2" StartPoint="3,0">
                                            <GradientStop Color="#FFAEAEAE" Offset="0.6"/>
                                            <GradientStop Color="#FE6A6A6A" Offset="1.2"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BitmapEffect>
                                        <BlurBitmapEffect Radius="1" KernelType="Gaussian"/>
                                    </Border.BitmapEffect>

                                    <ContentPresenter x:Name="CardContentPresenter"
                                                      ContentTemplate="{StaticResource ListItemDataTemplate}"/>
                                </Border>
                            </CustomControls:FloatingGrid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProductionCardDeckViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="TopPanelGrid"
          HorizontalAlignment="Center"
          VerticalAlignment="Top">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True"
                   VerticalAlignment="Top">

            <userControls:ProcessContainerView DockPanel.Dock="Left"
                                               MinWidth="50"
                                               Panel.ZIndex="99999999"/>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Center">
                <Label Content="Program Step: "/>
                <Label Content="{Binding ElementName=CardDeckListBox, Converter={StaticResource AddOneToValue}, Path=SelectedIndex}"/>
                <Label Content=" / "/>
                <Label Content="{Binding ElementName=CardDeckListBox, Path=Items.Count}"/>
            </StackPanel>

            <Image Source="{Binding ProcessDisplay}"
                        Stretch="Uniform"
                        DockPanel.Dock="Left"
                        HorizontalAlignment="Center">
            </Image>
        </DockPanel>

        <ListBox x:Name="CardDeckListBox"
                 ItemsSource="{Binding ProductionDeck}"
                 AlternationCount="{Binding ProductionDeck.Count}"
                 MaxHeight="300"
                 DockPanel.Dock="Bottom"
                 SelectedIndex="{Binding CurrentIndex}"
                 ItemContainerStyle="{DynamicResource ListBoxItemCardStyler}"
                 Background="Violet"
                 Grid.Row="1">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <CustomControls:CarouselPanel IsItemsHost="True"
                                                  x:Name="CarouselPanelItemHost">
                        <CustomControls:CarouselPanel.Triggers>
                            
                        </CustomControls:CarouselPanel.Triggers>
                    </CustomControls:CarouselPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Grid VerticalAlignment="Stretch">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        MaxHeight="1000">
                        </ItemsPresenter>

                    </Grid>
                </ControlTemplate>
            </ListBox.Template>

            <ListBox.Resources>

            </ListBox.Resources>

        </ListBox>

    </Grid>
</UserControl>