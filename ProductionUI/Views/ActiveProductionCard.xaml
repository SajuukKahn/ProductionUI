<UserControl x:Class="ProductionUI.Views.ActiveProductionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductionUI.Views"
             xmlns:vm="clr-namespace:ProductionUI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:ActiveProductionCardViewModel/>
    </UserControl.DataContext>

    <StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Grid.Column="0" >
                <Label Content="Zone: "/>
                <Label Content="{Binding ProcessLocation}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Column="1">
                <Label Content="Program: "/>
                <Label Content="{Binding ProgramName}"/>

            </StackPanel>


            <StackPanel Orientation="Horizontal"
                        Grid.Column="2">
                <Button Content="Play"
                        Command="{Binding PlayButton}"
                        Padding="12, 0"
                        Margin="2">
                </Button>

                <Button Content="Pause"
                        Command="{Binding PauseButton}"
                        Padding="12, 0"
                        Margin="2">
                </Button>

            </StackPanel>
        </Grid>

        <DockPanel LastChildFill="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <StackPanel DockPanel.Dock="Left">
                    <Label Content="{Binding StepDataDisplay}"/>
                    <Label Content="{Binding StepActiveTime}"/>
                    <Label Content="{Binding StepPointData}"/>
                </StackPanel>
                <Image Grid.Column="1"
                       Source="{Binding}"/>
            </Grid>
        </DockPanel>
    </StackPanel>

</UserControl>
