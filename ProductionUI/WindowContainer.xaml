<Window x:Class="ProductionUI.WindowContainer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductionUI"
        xmlns:userControls="clr-namespace:ProductionUI.Views"
        mc:Ignorable="d"
        Title="Container"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>

    </Window.Resources>

    <Grid x:Name="Dock">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <userControls:ProcessContainerView Height="25"
                                           Grid.Row="0"/>

        <userControls:ProductionCardDeckView Grid.Row="1"/>


    </Grid>


</Window>
